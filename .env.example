# OpenAI-compatible LLM endpoint (LiteLLM proxy). Local Ollama: http://localhost:11434/v1
LITELLM_API=http://192.168.1.60:4000
LITELLM_KEY=sk-your-litellm-key
LITELLM_DEFAULT_MODEL=gpt-4o-mini
# Gemini API instead: LITELLM_API=https://generativelanguage.googleapis.com/v1beta/openai/ (native Gemini client is used automatically)
# LLM_PROVIDER=openai|google  (optional override)

# local = own registry service; litellm = LiteLLM agent registry (then REGISTRY_URL = LiteLLM proxy URL)
REGISTRY_BACKEND=local
REGISTRY_URL=http://localhost:8000
# Optional shared secret required to register/deregister agents
REGISTRY_TOKEN=
REGISTRY_TTL_SECONDS=30
HEARTBEAT_SECONDS=10

A2A_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=1024
